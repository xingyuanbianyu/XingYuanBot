{
    "version": 3,
    "title": "✦ 星缘机器人 · 指令帮助 ✦",
    "footer": "💡 更多功能正在开发中，敬请期待~",
    "commands": {
        "1": {
            "cmd": "#帮助",
            "desc": "查看本帮助信息"
        },
        "2": {
            "cmd": "#权限",
            "desc": "查询自己的权限等级"
        },
        "3": {
            "cmd": "#状态",
            "desc": "查看机器人运行状态"
        },
        "4": {
            "cmd": "#退出",
            "desc": "关闭机器人"
        },
        "5": {
            "cmd": "#重启",
            "desc": "重启机器人"
        },
        "6": {
            "cmd": "#踢@成员",
            "desc": "将指定成员踢出群聊"
        },
        "7": {
            "cmd": "#禁言@成员QQ号 秒",
            "desc": "禁言指定成员，默认600秒"
        },
        "8": {
            "cmd": "#解禁@QQ号",
            "desc": "解除指定成员的禁言"
        },
        "9": {
            "cmd": "#头衔 内容/#申请头衔 内容",
            "desc": "给自己设置专属头衔（需机器人是群主）"
        },
        "10": {
            "cmd": "#设置管理@成员",
            "desc": "将指定成员设为管理员（需大主人权限）"
        },
        "11": {
            "cmd": "#取消管理@成员",
            "desc": "将指定成员降为普通成员（需大主人权限）"
        },
        "12": {
            "cmd": "#点赞/#赞我",
            "desc": "让机器人给你点赞（好友10次，非好友50次）"
        },
        "13": {
            "cmd": "#撤回",
            "desc": "撤回你引用的消息"
        },
        "14": {
             "cmd": "#拉黑 QQ 0/#拉黑 Q群 1",
             "desc": "机器人拉黑对应的人（0）或者群（1）"
        },
        "15": {
             "cmd": "#取消 QQ 0/#取消 Q群 1",
             "desc": "将对应的人（0）或者群（1）取消黑名单"
        },
        "16": {
             "cmd": "#改头衔",
             "desc": "让群主机器人改其他人的头衔（需要配置里的主人权限或者群管理权限"
        }
    },
    "categories": [
