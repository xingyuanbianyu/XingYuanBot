// xy-lib/log.js
// ✅ 通用日志模块 — 创建 / 写入 / 清除

const fs = require('fs');
const path = require('path');

const LOG_DIR = path.join(__dirname, '../../', 'LOG');

// 确保 LOG 目录存在
if (!fs.existsSync(LOG_DIR)) {
  fs.mkdirSync(LOG_DIR, { recursive: true });
}

// ========================
// 写入日志（追加模式）
// ========================
/**
 * @param {string} moduleName - 模块名（用于文件名和日志前缀）
 * @param {string} content    - 日志内容
 * @param {string} [ext='.log'] - 后缀名，支持 '.log' 或 '.txt'
 */
globalThis.writeLog = function (moduleName, content, ext = '.log') {
  if (!moduleName || typeof moduleName !== 'string') {
    globalThis.print(`⚠️ [writeLog] 模块名无效: ${moduleName}`);
    return;
  }

  const validExt = ext === '.txt' ? '.txt' : '.log';
  
  // 只用“日期”做文件名，解决一秒一个文件的问题
  const today = globalThis.now().split(' ')[0]; // 提取出 YYYY-MM-DD
  const fileName = `${moduleName}_${today}${validExt}`;
  const filePath = path.join(LOG_DIR, fileName);

  const timeStr = globalThis.now();
  const line = `[${timeStr}] [${moduleName}] ${content}\n`;

  try {
    fs.appendFileSync(filePath, line, 'utf8');
    return filePath;
  } catch (err) {
    globalThis.print(`❌ [writeLog] 写入失败: ${err.message}`);
    return null;
  }
};

// ========================
// 清除日志（支持按天数保留，自带占位符数字提取）
// ========================
/**
 * @param {string} [moduleName] - 模块名，传则只清该模块；不传则清空全部
 * @param {number|string} [keepDays] - 保留天数。⭐不传则默认清理所有日志（按 0 天处理）
 * @param {string} [ext]        - 限定后缀，如 '.log' 或 '.txt'
 */
globalThis.clearLog = function (moduleName, keepDays, ext) {
  if (!fs.existsSync(LOG_DIR)) return 0;

  // 🌟 核心修复：默认清理全部！
  // 如果没传 keepDays，就意味着你要“清空该模块的所有日志”，所以天数默认为 0。
  let daysToKeep = 0; 
  if (keepDays !== undefined && keepDays !== null) {
    // 如果传了参数（如 "7天"），正则自动提取数字，跳过所有符号
    const numMatch = String(keepDays).match(/\d+/);
    if (numMatch) {
      daysToKeep = parseInt(numMatch[0], 10);
    }
  }

  const now = Date.now();
  const msPerDay = 24 * 60 * 60 * 1000;
  // 如果 daysToKeep 是 0，cutoffTime 就是现在，所有历史文件都会被删掉
  const cutoffTime = now - (daysToKeep * msPerDay); 

  const files = fs.readdirSync(LOG_DIR);
  let count = 0;

  for (const file of files) {
    if (file === '.gitkeep' || file === '.gitignore') continue;

    // 🌟 核心机制：框架直接帮你认前缀！
    // 你不需要写任何循环去切字符串，startsWith 会完美匹配 "daily-tool_xxx.log"
    if (moduleName && !file.startsWith(moduleName)) continue;
    // 按后缀过滤
    if (ext && !file.endsWith(ext)) continue;

    const filePath = path.join(LOG_DIR, file);
    
    try {
      const stats = fs.statSync(filePath);
      if (stats.mtimeMs < cutoffTime) {
        fs.unlinkSync(filePath);
        count++;
      }
    } catch (err) {
      globalThis.print(`❌ [clearLog] 删除 ${file} 失败: ${err.message}`);
    }
  }

  // 根据传参情况，给出更清晰的日志提示
  const dayMsg = daysToKeep === 0 ? '全部' : `超过 ${daysToKeep} 天`;
  globalThis.print(`🗑️ [clearLog] 已清除 ${count} 个日志文件（${moduleName || '全部模块'}，${dayMsg}）`);
  return count;
};